# /etc/inittab: FlipperOS boot menu initramfs (BusyBox init)
#
# Format: <id>:<runlevels>:<action>:<process>   (runlevels are ignored)
#
# Buildroot's initramfs pre-init (/init) has already mounted devtmpfs on /dev
# and exec'd busybox init. Bring up the rest, start udev so the panel and the
# buttons appear, then run the menu.

# All sysinit entries run (in order, to completion) before the respawn entry.
::sysinit:/bin/mount -t proc  proc  /proc
::sysinit:/bin/mount -t sysfs sysfs /sys
::sysinit:/bin/mkdir -p /dev/pts /dev/shm /run
::sysinit:/bin/mount -t devpts devpts /dev/pts
# Run the S?? scripts (S10udevd starts udevd, coldplugs devices, settles).
::sysinit:/etc/init.d/rcS

# What init execs, in its own place, when boot-profile asks for a pivot with SIGQUIT: the
# shutdown actions run, every process is killed, and this replaces init itself. It is the only
# way the profile's systemd can end up as PID 1. Nothing else sends init SIGQUIT.
::restart:/usr/bin/boot-pivot

# The menu, restarted if it exits: there is nothing else for this image to do,
# and a menu that has died leaves a device with no way to boot anything.
console::respawn:/usr/bin/boot-menu-launch

# A shell on the serial console, for diagnosing this image from a desk: it has no
# network, so this is the only way in that is not the panel itself.
::respawn:/usr/bin/serial-console

# Ctrl-Alt-Del reboots.
::ctrlaltdel:/sbin/reboot

# Shutdown sequence.
::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
